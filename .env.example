# demo uses a simulated provider; sandbox calls PayPal with test money.
PAYPAL_ENV=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Public HTTPS origin used for sandbox checkout return and webhooks.
PUBLIC_URL=http://localhost:4310
PORT=4310
# Optional. Without this, the request form is a manual proposal, not AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local SQLite directory. Test runners override this with a disposable directory.
DATA_DIR=data

# Elastic audit search: Elasticsearch endpoint and encoded API key (server-side only).
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
